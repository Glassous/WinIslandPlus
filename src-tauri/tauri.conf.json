{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WinIslandPlus",
  "version": "1.1.10",
  "identifier": "com.winisland.plus",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "island",
        "title": "WinIslandPlus",
        "url": "island.html",
        "width": 336,
        "height": 230,
        "x": 0,
        "y": 0,
        "center": false,
        "visible": false,
        "focus": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "dragDropEnabled": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "WinIslandPlus",
    "copyright": "Copyright 2026 Ye Yongyan",
    "category": "Utility",
    "shortDescription": "Windows 11 灵动岛",
    "longDescription": "面向 Windows 11 的灵动岛桌面小工具：检测到系统媒体播放时，屏幕顶部居中浮现一枚黑色胶囊，点击展开为媒体控制卡片。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "compression": "lzma"
      }
    }
  }
}
